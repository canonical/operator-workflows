{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:base",
    "group:all"
  ],
  "schedule": [
    "* * * * 0,6"
  ],
  "packageRules": [
    {
      "description": "Hold TypeScript below 7 until @typescript-eslint supports it (peer: typescript >=4.8.4 <6.1.0).",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
